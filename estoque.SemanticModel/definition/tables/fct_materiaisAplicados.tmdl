		summarizeBy: none
		sourceColumn: numero_serie

		annotation SummarizationSetBy = Automatic

	column tem_caracter_incorreto = ```
			
			
			VAR ignorarCategorias = NOT(fct_materiaisAplicados[categoria_tecnologia] IN {"SEM INFORMACAO", "MISCELANEA", "INSUMO"})
			VAR ignorarNaoSerializados = fct_materiaisAplicados[numero_serie] <> "-"
			
			VAR serialAtual = fct_materiaisAplicados[numero_serie]
			VAR tamanhoSerial = LEN(serialAtual)
			
			
			VAR sequenciaZeros = REPT("0", tamanhoSerial)
			VAR sequenciaUns = REPT("1", tamanhoSerial)
			
			VAR ehRepeticaoInvalida = 
			    tamanhoSerial >= 1 && 
			    tamanhoSerial <= 7 && 
			    (serialAtual = sequenciaZeros || serialAtual = sequenciaUns)
			
			RETURN
			IF(
			    CONTAINSSTRING(serialAtual, " ") ||
			    CONTAINSSTRING(serialAtual, "/") ||
			    CONTAINSSTRING(serialAtual, "\") ||
			    CONTAINSSTRING(serialAtual, ".") ||
			    CONTAINSSTRING(serialAtual, ",") ||
			    CONTAINSSTRING(serialAtual, "+") ||
			    CONTAINSSTRING(serialAtual, ":") ||
			    CONTAINSSTRING(serialAtual, ";") ||
			    CONTAINSSTRING(serialAtual, "!") ||
			    CONTAINSSTRING(serialAtual, "(") ||
			    CONTAINSSTRING(serialAtual, ")") ||
			    CONTAINSSTRING(serialAtual, "&") ||
			    CONTAINSSTRING(serialAtual, "$") ||
			    CONTAINSSTRING(serialAtual, "@") ||
			    CONTAINSSTRING(serialAtual, "~*") ||
			    CONTAINSSTRING(serialAtual, "~?") ||
			    CONTAINSSTRING(serialAtual, "~~") || 
			    CONTAINSSTRING(serialAtual, "^") ||
			    CONTAINSSTRING(serialAtual, "<") ||
			    CONTAINSSTRING(serialAtual, ">") ||
			    CONTAINSSTRING(serialAtual, "´") ||
			    CONTAINSSTRING(serialAtual, "`") ||
			    CONTAINSSTRING(serialAtual, "'") ||
			    CONTAINSSTRING(serialAtual, "%") ||
			    CONTAINSSTRING(serialAtual, "[") ||
			    CONTAINSSTRING(serialAtual, "]") ||
			    CONTAINSSTRING(serialAtual, "{") ||
			    CONTAINSSTRING(serialAtual, "}") ||
			    ehRepeticaoInvalida ||
			    (serialAtual = "SN" && ignorarCategorias) ||
			    (tamanhoSerial < 8 && ignorarNaoSerializados && ignorarCategorias) ||
			    (ignorarNaoSerializados && CONTAINSSTRING(serialAtual, "-") && ignorarCategorias), 
			    "SIM", 
			    "NÃO"
			)
			```
		lineageTag: 7a16921d-5ffd-4832-a031-4fff5e25ee7f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	partition fct_materiaisAplicados = m
		mode: import
		source = ```
				let
				    Fonte = PostgreSQL.Database(host, database, 
				    [Query=
				    "	
				        select
				            dim_movimentacao_material.sk_movimentacao_material,
				            dim_movimentacao_material.numero_documento,
				            dim_movimentacao_material.contrato,
				            dim_movimentacao_material.projeto,
				            dim_movimentacao_material.condicao,
				            dim_movimentacao_material.serializado,
				            dim_movimentacao_material.data_movimento as data_aplicacao,
				            fct_movimentacao_material_aplicado.quantidade,
				            dim_solicitacao.bk_protocolo,
				            dim_solicitacao.fonte_sistema,
							coalesce(dim_solicitacao.base, dim_movimentacao_material.base) as base,
				            dim_solicitacao.tipo_solicitacao,
				            dim_solicitacao.status_protocolo,
				            dim_solicitacao.grupo_servico,
				            dim_solicitacao.data_fechamento as data_baixa_protocolo,
				            dim_material.bk_material,
				            dim_material.descricao_material,
				            dim_material.unidade_medida,
				            dim_material.familia,
				            dim_material.categoria_tecnologia,
				            dim_colaborador.cpf_colaborador,
				            dim_colaborador.nome,
				            dim_colaborador.descricao_funcao,
				            COALESCE(dim_serial_equipamento.numero_serie, dim_movimentacao_material.numero_serie) as numero_serie
				        from gold.dim_movimentacao_material as dim_movimentacao_material
				        inner join gold.fct_movimentacao_material_aplicado AS fct_movimentacao_material_aplicado ON (fct_movimentacao_material_aplicado.sk_movimentacao_material = dim_movimentacao_material.sk_movimentacao_material)
				        left join gold.dim_material as dim_material on (dim_material.sk_material = fct_movimentacao_material_aplicado.sk_material)
				        left join gold.dim_colaborador as dim_colaborador on (dim_colaborador.sk_colaborador = fct_movimentacao_material_aplicado.sk_colaborador)
				        left join gold.dim_serial_equipamento as dim_serial_equipamento on (dim_serial_equipamento.sk_numero_serie = fct_movimentacao_material_aplicado.sk_numero_serie)
				        left join gold.dim_solicitacao as dim_solicitacao on (dim_solicitacao.sk_protocolo::bigint = fct_movimentacao_material_aplicado.sk_protocolo)
						WHERE
								data_movimento >= DATE_TRUNC('month', CURRENT_DATE - INTERVAL '6 month') AND data_movimento < CURRENT_DATE
				    "
				    ]),
				    #"Dividir Coluna por Delimitador" = Table.SplitColumn(Table.TransformColumnTypes(Fonte, {{"data_aplicacao", type text}}, "pt-BR"), "data_aplicacao", Splitter.SplitTextByEachDelimiter({" "}, QuoteStyle.Csv, false), {"data_aplicacao.1", "data_aplicacao.2"}),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Dividir Coluna por Delimitador",{{"data_aplicacao.1", type date}, {"data_aplicacao.2", type time}}),
				    #"Texto Extraído Antes do Delimitador" = Table.TransformColumns(#"Tipo Alterado", {{"bk_protocolo", each Text.BeforeDelimiter(_, "/"), type text}})
				in
				    #"Texto Extraído Antes do Delimitador"
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

