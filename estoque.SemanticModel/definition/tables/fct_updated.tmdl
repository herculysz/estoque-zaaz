table fct_updated
	lineageTag: 24aab227-f0c9-4260-9ede-28d7117885fe

	measure Update = MAX(fct_updated[DataHoraAtualização])
		formatString: General Date
		lineageTag: e002cf9e-a6a5-40ef-8319-f87551f5e8c3

	column DataHoraAtualização
		dataType: dateTime
		formatString: General Date
		lineageTag: 7557e928-680e-437f-b9d0-68a4499f1a71
		summarizeBy: none
		sourceColumn: DataHoraAtualização

		variation Variation
			isDefault
			relationship: 12866435-6987-4fdf-8e76-32c56c1778af
			defaultHierarchy: LocalDateTable_9cfbe248-d5ed-44de-948e-1089db6ec2eb.'Hierarquia de datas'

	partition fct_updated = m
		mode: import
		source =
				let
				    HorarioUTC =
				        DateTimeZone.FixedUtcNow(),
				
				    HorarioBrasilia =
				        DateTimeZone.SwitchZone(
				            HorarioUTC,
				            -3
				        ),
				
				    DataHoraSemFuso =
				        DateTimeZone.RemoveZone(
				            HorarioBrasilia
				        ),
				
				    Fonte =
				        #table(
				            type table [
				                DataHoraAtualização = datetime
				            ],
				            {
				                {
				                    DataHoraSemFuso
				                }
				            }
				        )
				in
				    Fonte

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

