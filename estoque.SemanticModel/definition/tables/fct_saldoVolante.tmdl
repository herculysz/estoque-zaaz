	column tem_caracter_incorreto = ```
			
			
			VAR ignorarCategorias = NOT(fct_saldoVolante[categoria_tecnologia] IN {"SEM INFORMACAO", "MISCELANEA", "INSUMO", ""})
			VAR ignorarNaoSerializados = fct_saldoVolante[numero_serie] <> "-"
			
			VAR serialAtual = fct_saldoVolante[numero_serie]
			VAR tamanhoSerial = LEN(serialAtual)
			
			
			VAR sequenciaZeros = REPT("0", tamanhoSerial)
			VAR sequenciaUns = REPT("1", tamanhoSerial)
			
			VAR ehRepeticaoInvalida = 
			    tamanhoSerial >= 1 && 
			    tamanhoSerial <= 7 && 
			    (serialAtual = sequenciaZeros || serialAtual = sequenciaUns)
			
			RETURN
			IF(
			    CONTAINSSTRING(serialAtual, " ") ||
			    CONTAINSSTRING(serialAtual, "/") ||
			    CONTAINSSTRING(serialAtual, "\") ||
			    CONTAINSSTRING(serialAtual, ".") ||
			    CONTAINSSTRING(serialAtual, ",") ||
			    CONTAINSSTRING(serialAtual, "+") ||
			    CONTAINSSTRING(serialAtual, ":") ||
			    CONTAINSSTRING(serialAtual, ";") ||
			    CONTAINSSTRING(serialAtual, "!") ||
			    CONTAINSSTRING(serialAtual, "(") ||
			    CONTAINSSTRING(serialAtual, ")") ||
			    CONTAINSSTRING(serialAtual, "&") ||
			    CONTAINSSTRING(serialAtual, "$") ||
			    CONTAINSSTRING(serialAtual, "@") ||
			    CONTAINSSTRING(serialAtual, "~*") ||
			    CONTAINSSTRING(serialAtual, "~?") ||
			    CONTAINSSTRING(serialAtual, "~~") || 
			    CONTAINSSTRING(serialAtual, "^") ||
			    CONTAINSSTRING(serialAtual, "<") ||
			    CONTAINSSTRING(serialAtual, ">") ||
			    CONTAINSSTRING(serialAtual, "´") ||
			    CONTAINSSTRING(serialAtual, "`") ||
			    CONTAINSSTRING(serialAtual, "'") ||
			    CONTAINSSTRING(serialAtual, "%") ||
			    CONTAINSSTRING(serialAtual, "[") ||
			    CONTAINSSTRING(serialAtual, "]") ||
			    CONTAINSSTRING(serialAtual, "{") ||
			    CONTAINSSTRING(serialAtual, "}") ||
			    ehRepeticaoInvalida ||
			    (serialAtual = "SN" && ignorarCategorias) ||
			    (tamanhoSerial < 8 && ignorarNaoSerializados && ignorarCategorias) ||
			    (ignorarNaoSerializados && [saldoV_disponivel] > 1) ||
			    ([saldoV_disponivel] < 0) ||
			    (ignorarNaoSerializados && CONTAINSSTRING(serialAtual, "-") && ignorarCategorias), /*  ||
			    ([saldoV_disponivel_graph] > 0 && [saldoV_disponivel_graph] < 1), */
			    "SIM", 
			    "NÃO"
			)
			```
		lineageTag: d7590260-5c2f-4547-bca4-18f6a7153ae4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

