		annotation SummarizationSetBy = Automatic

	partition fct_saldoVolante = m
		mode: import
		source = ```
				let
				    Fonte = Value.NativeQuery(PostgreSQL.Database(hostname, db), "
				
					/* SALDO TECNICO */
					with max_data_saldo as (
						select distinct
							dim_saldo_tecnico_estoque.base as base,
							max(dim_saldo_tecnico_estoque.data_saldo) as data_saldo
						from gold.dim_saldo_tecnico_estoque as dim_saldo_tecnico_estoque
						group by dim_saldo_tecnico_estoque.base
					)
					select distinct
						dim_saldo_tecnico_estoque.sk_saldo,
						dim_saldo_tecnico_estoque.data_saldo,
						--dim_saldo_tecnico_estoque.contrato, --Para o calculo estar correto com o aniel, essa coluna não pode fazer parte da tabela
						--dim_saldo_tecnico_estoque.projeto, --Para o calculo estar correto com o aniel, essa coluna não pode fazer parte da tabela
						dim_saldo_tecnico_estoque.base,
						dim_colaborador.cpf_colaborador,
						dim_colaborador.nome,
						dim_colaborador.descricao_funcao,
						dim_colaborador.supervisor,
						dim_colaborador.coordenador,
						dim_colaborador.gerente,
						dim_colaborador.diretor,
						dim_material.bk_material,
						dim_material.descricao_material,
						dim_material.unidade_medida,
						dim_material.categoria_tecnologia,
						dim_saldo_tecnico_estoque.condicao,
						dim_saldo_tecnico_estoque.serializado,
						dim_saldo_tecnico_estoque.numero_serie,
						fct_saldo_tecnico.saldo,
						fct_saldo_tecnico.dias_posse
					from max_data_saldo
					left join gold.dim_saldo_tecnico_estoque as dim_saldo_tecnico_estoque on (dim_saldo_tecnico_estoque.base = max_data_saldo.base
					and dim_saldo_tecnico_estoque.data_saldo = max_data_saldo.data_saldo)
					inner join gold.fct_saldo_tecnico as fct_saldo_tecnico on (fct_saldo_tecnico.sk_saldo = dim_saldo_tecnico_estoque.sk_saldo)
					left join gold.dim_material as dim_material on (dim_material.sk_material = fct_saldo_tecnico.sk_material)                                                                                                                                                    
					left join gold.dim_colaborador as dim_colaborador on (dim_colaborador.sk_colaborador = fct_saldo_tecnico.sk_colaborador)
					WHERE fct_saldo_tecnico.saldo <> 0 AND dim_material.bk_material is not null
				
					", null, [EnableFolding=true]),
				    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"data_saldo", type date}})
				in
				    #"Tipo Alterado"
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

