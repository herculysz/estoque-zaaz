	partition fct_materiaisRetirados = m
		mode: import
		source = ```
				let
				    Fonte = Value.NativeQuery(PostgreSQL.Database(hostname, db), "
				    SELECT DISTINCT
				        dim_movimentacao_material.sk_movimentacao_material,
				        dim_movimentacao_material.numero_documento,
				        dim_movimentacao_material.contrato,
				        dim_movimentacao_material.projeto,
				        dim_movimentacao_material.condicao,
				        dim_movimentacao_material.serializado,
				        dim_movimentacao_material.data_movimento AS data_inclusao_material, --AS data_aplicacao,
				        fct_movimentacao_material_retirado.quantidade_removida,
				        dim_solicitacao.bk_protocolo,
				        dim_solicitacao.fonte_sistema,
				        --dim_solicitacao.base,
						coalesce(dim_solicitacao.base, dim_movimentacao_material.base) as base,
				        dim_solicitacao.tipo_solicitacao,
				        dim_solicitacao.status_protocolo,
				        dim_solicitacao.grupo_servico,
				        --dim_solicitacao.data_fechamento AS data_baixa_protocolo,
						coalesce(dim_solicitacao.data_fechamento, dim_movimentacao_material.data_aplicacao) as data_baixa_protocolo,
				        dim_material.bk_material,
				        dim_material.descricao_material,
				        dim_material.unidade_medida,
				        dim_material.familia,
				        dim_material.categoria_tecnologia,
				        dim_colaborador.cpf_colaborador,
				        dim_colaborador.nome,
				        dim_colaborador.descricao_funcao,
						dim_colaborador.supervisor,
						dim_colaborador.coordenador,
						dim_colaborador.gerente,
						dim_colaborador.diretor,
				    	COALESCE(dim_serial_equipamento.numero_serie, dim_movimentacao_material.numero_serie) as numero_serie
				    FROM gold.dim_movimentacao_material AS dim_movimentacao_material
				    INNER JOIN gold.fct_movimentacao_material_retirado AS fct_movimentacao_material_retirado 
				        ON (fct_movimentacao_material_retirado.sk_movimentacao_material = dim_movimentacao_material.sk_movimentacao_material)
				    LEFT JOIN gold.dim_material AS dim_material 
				        ON (dim_material.sk_material = fct_movimentacao_material_retirado.sk_material)
				    LEFT JOIN gold.dim_colaborador AS dim_colaborador 
				        ON (dim_colaborador.sk_colaborador = fct_movimentacao_material_retirado.sk_colaborador)
				    LEFT JOIN gold.dim_serial_equipamento AS dim_serial_equipamento 
				        ON (dim_serial_equipamento.sk_numero_serie = fct_movimentacao_material_retirado.sk_numero_serie)
				    LEFT JOIN gold.dim_solicitacao AS dim_solicitacao 
				        ON (dim_solicitacao.sk_protocolo::bigint = fct_movimentacao_material_retirado.sk_protocolo)
				    WHERE
						dim_solicitacao.data_fechamento >= '2026-01-01'
						OR (dim_solicitacao.data_fechamento IS NULL AND dim_movimentacao_material.data_aplicacao >= '2026-01-01')
						--COALESCE(dim_solicitacao.data_fechamento, dim_movimentacao_material.data_aplicacao) >= '2026-01-01'
						--data_fechamento >= DATE_TRUNC('month', CURRENT_DATE - INTERVAL '6 month') 
				        --data_movimento >= DATE_TRUNC('month', CURRENT_DATE - INTERVAL '6 month') 
				        --AND data_movimento < CURRENT_DATE
				    ", null, [EnableFolding=true]),
				    #"Dividir Coluna por Delimitador" = Table.SplitColumn(Table.TransformColumnTypes(Fonte, {{"data_inclusao_material", type text}}, "pt-BR"), "data_inclusao_material", Splitter.SplitTextByEachDelimiter({" "}, QuoteStyle.Csv, false), {"data_inclusao_material.1", "data_inclusao_material.2"}),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Dividir Coluna por Delimitador",{{"data_inclusao_material.1", type date}, {"data_inclusao_material.2", type time}}),
				    #"Dividir Coluna por Delimitador1" = Table.SplitColumn(Table.TransformColumnTypes(#"Tipo Alterado", {{"data_baixa_protocolo", type text}}, "pt-BR"), "data_baixa_protocolo", Splitter.SplitTextByEachDelimiter({" "}, QuoteStyle.Csv, false), {"data_baixa_protocolo.1", "data_baixa_protocolo.2"}),
				    #"Tipo Alterado1" = Table.TransformColumnTypes(#"Dividir Coluna por Delimitador1",{{"data_baixa_protocolo.1", type date}, {"data_baixa_protocolo.2", type time}}),
				    #"Colunas Renomeadas" = Table.RenameColumns(#"Tipo Alterado1",{{"data_baixa_protocolo.1", "baixa_protocolo_data"}, {"data_baixa_protocolo.2", "baixa_protocolo_hora"}, {"data_inclusao_material.1", "inclusao_material_data"}, {"data_inclusao_material.2", "inclusao_material_hora"}})
				in
				    #"Colunas Renomeadas"
				```

	annotation PBI_NavigationStepName = Navegação

	annotation PBI_ResultType = Table

