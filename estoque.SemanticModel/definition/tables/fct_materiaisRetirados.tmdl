	column numero_serie
		dataType: string
		lineageTag: 8e892fc7-cf26-4bce-8940-132f0d9692e4
		summarizeBy: none
		sourceColumn: numero_serie

		annotation SummarizationSetBy = Automatic

	column tem_caracter_incorreto = ```
			
			
			VAR ignorarCategorias = NOT(fct_materiaisRetirados[categoria_tecnologia] IN {"SEM INFORMACAO", "MISCELANEA", "INSUMO"})
			VAR ignorarNaoSerializados = fct_materiaisRetirados[numero_serie] <> "-"
			
			VAR serialAtual = fct_materiaisRetirados[numero_serie]
			VAR tamanhoSerial = LEN(serialAtual)
			
			
			VAR sequenciaZeros = REPT("0", tamanhoSerial)
			VAR sequenciaUns = REPT("1", tamanhoSerial)
			
			VAR ehRepeticaoInvalida = 
			    tamanhoSerial >= 1 && 
			    tamanhoSerial <= 7 && 
			    (serialAtual = sequenciaZeros || serialAtual = sequenciaUns)
			
			RETURN
			IF(
			    CONTAINSSTRING(serialAtual, " ") ||
			    CONTAINSSTRING(serialAtual, "/") ||
			    CONTAINSSTRING(serialAtual, "\") ||
			    CONTAINSSTRING(serialAtual, ".") ||
			    CONTAINSSTRING(serialAtual, ",") ||
			    CONTAINSSTRING(serialAtual, "+") ||
			    CONTAINSSTRING(serialAtual, ":") ||
			    CONTAINSSTRING(serialAtual, ";") ||
			    CONTAINSSTRING(serialAtual, "!") ||
			    CONTAINSSTRING(serialAtual, "(") ||
			    CONTAINSSTRING(serialAtual, ")") ||
			    CONTAINSSTRING(serialAtual, "&") ||
			    CONTAINSSTRING(serialAtual, "$") ||
			    CONTAINSSTRING(serialAtual, "@") ||
			    CONTAINSSTRING(serialAtual, "~*") ||
			    CONTAINSSTRING(serialAtual, "~?") ||
			    CONTAINSSTRING(serialAtual, "~~") || 
			    CONTAINSSTRING(serialAtual, "^") ||
			    CONTAINSSTRING(serialAtual, "<") ||
			    CONTAINSSTRING(serialAtual, ">") ||
			    CONTAINSSTRING(serialAtual, "´") ||
			    CONTAINSSTRING(serialAtual, "`") ||
			    CONTAINSSTRING(serialAtual, "'") ||
			    CONTAINSSTRING(serialAtual, "%") ||
			    CONTAINSSTRING(serialAtual, "[") ||
			    CONTAINSSTRING(serialAtual, "]") ||
			    CONTAINSSTRING(serialAtual, "{") ||
			    CONTAINSSTRING(serialAtual, "}") ||
			    ehRepeticaoInvalida ||
			    (serialAtual = "SN" && ignorarCategorias) ||
			    (tamanhoSerial < 8 && ignorarNaoSerializados && ignorarCategorias) ||
			    (ignorarNaoSerializados && CONTAINSSTRING(serialAtual, "-") && ignorarCategorias), 
			    "SIM", 
			    "NÃO"
			)
			```
		lineageTag: 2cebb913-e6ce-4bad-8826-3fee6f3c41c3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

