	partition fct_materiaisRetirados = m
		mode: import
		source =
				let
				    Fonte = Value.NativeQuery(PostgreSQL.Database(host, database), "select#(lf)    dim_movimentacao_material.sk_movimentacao_material,#(lf)    dim_movimentacao_material.numero_documento,#(lf)    dim_movimentacao_material.contrato,#(lf)    dim_movimentacao_material.projeto,#(lf)    dim_movimentacao_material.condicao,#(lf)    dim_movimentacao_material.serializado,#(lf)    dim_movimentacao_material.data_movimento as data_aplicacao,#(lf)    fct_movimentacao_material_retirado.quantidade_removida,#(lf)    dim_solicitacao.bk_protocolo,#(lf)    dim_solicitacao.fonte_sistema,#(lf)    dim_solicitacao.base,#(lf)    dim_solicitacao.tipo_solicitacao,#(lf)    dim_solicitacao.status_protocolo,#(lf)    dim_solicitacao.grupo_servico,#(lf)    dim_solicitacao.data_fechamento as data_baixa_protocolo,#(lf)    dim_material.bk_material,#(lf)    dim_material.descricao_material,#(lf)    dim_material.unidade_medida,#(lf)    dim_material.familia,#(lf)    dim_material.categoria_tecnologia,#(lf)    dim_colaborador.cpf_colaborador,#(lf)    dim_colaborador.nome,#(lf)    dim_colaborador.descricao_funcao,#(lf)    dim_serial_equipamento.numero_serie#(lf)from gold.dim_movimentacao_material as dim_movimentacao_material#(lf)inner join gold.fct_movimentacao_material_retirado AS fct_movimentacao_material_retirado ON (fct_movimentacao_material_retirado.sk_movimentacao_material = dim_movimentacao_material.sk_movimentacao_material)#(lf)left join gold.dim_material as dim_material on (dim_material.sk_material = fct_movimentacao_material_retirado.sk_material)#(lf)left join gold.dim_colaborador as dim_colaborador on (dim_colaborador.sk_colaborador = fct_movimentacao_material_retirado.sk_colaborador)#(lf)left join gold.dim_serial_equipamento as dim_serial_equipamento on (dim_serial_equipamento.sk_numero_serie = fct_movimentacao_material_retirado.sk_numero_serie)#(lf)left join gold.dim_solicitacao as dim_solicitacao on (dim_solicitacao.sk_protocolo::bigint = fct_movimentacao_material_retirado.sk_protocolo)#(lf)WHERE#(lf)#(tab)data_movimento >= DATE_TRUNC('month', CURRENT_DATE - INTERVAL '6 month') AND data_movimento < CURRENT_DATE", null, [EnableFolding=true]),
				    #"Dividir Coluna por Delimitador" = Table.SplitColumn(Table.TransformColumnTypes(Fonte, {{"data_aplicacao", type text}}, "pt-BR"), "data_aplicacao", Splitter.SplitTextByEachDelimiter({" "}, QuoteStyle.Csv, false), {"data_aplicacao.1", "data_aplicacao.2"}),
				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Dividir Coluna por Delimitador",{{"data_aplicacao.1", type date}, {"data_aplicacao.2", type time}})
				in
				    #"Tipo Alterado"

	annotation PBI_NavigationStepName = Navegação

