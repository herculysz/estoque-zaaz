	partition Empresa = calculated
		mode: import
		source = ```
				
				
				DISTINCT(
				    UNION(
				        SELECTCOLUMNS(fct_saldoEstoque, "Empresa", fct_saldoEstoque[base]),
				        SELECTCOLUMNS(fct_saldoVolante, "Empresa", fct_saldoVolante[base]),
				        SELECTCOLUMNS(fct_materiaisRetirados, "Empresa", fct_materiaisRetirados[base]),
				        SELECTCOLUMNS(fct_materiaisAplicados, "Empresa", fct_materiaisAplicados[base]),
				        SELECTCOLUMNS(fct_devolucaoMaterial, "Empresa", fct_devolucaoMaterial[base]),
				        SELECTCOLUMNS(fct_requisicaoMaterial, "Empresa", fct_requisicaoMaterial[base]),
				        SELECTCOLUMNS(fct_conversaoMateriais, "Empresa", fct_conversaoMateriais[base])
				    )
				)
				
				
				
				```

	annotation PBI_Id = 99d3c7c9d05b4308990e7a0943918659

