		displayFolder: Conversão
		lineageTag: 53971899-147b-445b-8180-6bc4adf3f94a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure qtd_Conv_Mes_Anterior = ```
			
			VAR MesAnterior = 
			CALCULATE(
			    [qtdConvertida], 
			    DATEADD('dim_Calendario'[data_formatada], -1, MONTH)
			)
			RETURN
			MesAnterior
			```
		formatString: 0
		displayFolder: Conversão
		lineageTag: 429d3dec-703a-4b51-8bda-32fd027204c4

	measure '% Diff_Conv_mes_Anterior' =
			
			VAR MesAtual = [qtdConvertida]
			VAR MesAnterior = [qtd_Conv_Mes_Anterior]
			VAR CalcDiffMes = DIVIDE( MesAtual - MesAnterior, MesAnterior, 0 )
			RETURN
			IF(CalcDiffMes >0, "+"&FORMAT(CalcDiffMes, "0.00%"), CalcDiffMes)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Conversão
		lineageTag: a99ca56a-2192-4a02-a05a-315344001f3a

	measure '% Convertido_mes' = ```
			
			
			VAR totalmes = 
			CALCULATE(
			    [qtdConvertida],
			    KEEPFILTERS('dim_calendario'),
			    ALLSELECTED(fct_conversaoMateriais[condicao_convertida])
			)
			RETURN
			
			" | " &
			FORMAT(
			    DIVIDE([qtdConvertida], totalmes, 0),
			    "0.00%"
			)
			```
		displayFolder: Conversão
		lineageTag: 4061218f-1f31-41ea-ae73-eee151e287c9

	measure @corEvoluçãoConv =
			
			
			VAR variavelCor = [% Diff_Conv_mes_Anterior]
			RETURN
			
			SWITCH(
			    TRUE(),
			    variavelCor = 0, BLANK(),
			    variavelCor < 0, "#A50B00",
			    variavelCor > 0 || CONTAINSSTRING("+", variavelCor), "#00A023",
			    BLANK()
			)
		displayFolder: Conversão
		lineageTag: eac5ff47-0a8e-4db7-adcd-2ddae245ae30

