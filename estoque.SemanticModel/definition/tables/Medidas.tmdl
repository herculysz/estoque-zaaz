table Medidas
	lineageTag: ec89080e-d392-4345-a7ba-04729daf1646

	calculationGroup

	measure saldoV_disponivel = ```
			
			/*VAR _MaxData = 
			    CALCULATE(
			        MAX(fct_saldoVolante[data_saldo])
			    )
			RETURN*/
			    CALCULATE(
			        SUM(fct_saldoVolante[saldo]),
			        fct_saldoVolante[descricao_material] <> "",
			        --fct_saldoVolante[data_saldo] = _MaxData
			        fct_saldoVolante[data_saldo] = MAX(fct_saldoVolante[data_saldo])
			    )
			```
		formatString: 0
		displayFolder: Volante
		lineageTag: ebc8bb00-0667-4860-8549-fe4c407f230e

		annotation PBI_FormatHint = {"isDecimal":true}

	measure saldoV_disponivel_graph =
			
			SUMX(
			    SUMMARIZE(
			        fct_saldoVolante,
			        fct_saldoVolante[descricao_material],
			        fct_saldoVolante[condicao],
			        fct_saldoVolante[bk_material],
			        fct_saldoVolante[serializado],
			        fct_saldoVolante[gerente],
			        fct_saldoVolante[coordenador],
			        fct_saldoVolante[supervisor],
			        fct_saldoVolante[nome],
			        fct_saldoVolante[tem_caracter_incorreto]
			
			    ),
			    --VAR _MaxData = CALCULATE(MAX(fct_saldoVolante[data_saldo]))
			    --RETURN
			        CALCULATE(
			            SUM(fct_saldoVolante[saldo]),
			            KEEPFILTERS(fct_saldoVolante[descricao_material] <> ""),
			            KEEPFILTERS(fct_saldoVolante[condicao] <> ""),
			            --fct_saldoVolante[data_saldo] = _MaxData
			            fct_saldoVolante[data_saldo] = MAX(fct_saldoVolante[data_saldo])
			        )
			)
		displayFolder: Volante
		lineageTag: 8163937d-cf3a-4aa8-ad9e-170b08b16157

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure saldoEF_disponivel = ```
			
			    CALCULATE(
			        SUM(fct_saldoEstoque[saldo_disponivel]),
			        fct_saldoEstoque[descricao_material] <> "",
			        fct_saldoEstoque[data_saldo] = MAX(fct_saldoEstoque[data_saldo])
			    )
			```
		formatString: #,0.00
		displayFolder: EstoqueFisico
		lineageTag: c70eed1c-15fb-43f0-9555-5e848e59d199

	measure saldoEF_disponivel_graph =
			
			
			SUMX(
			    SUMMARIZE(
			        fct_saldoEstoque,
			        fct_saldoEstoque[contrato],
			        fct_saldoEstoque[projeto],
			        fct_saldoEstoque[bk_material],
			        fct_saldoEstoque[descricao_material],
			        fct_saldoEstoque[categoria_tecnologia],
			        fct_saldoEstoque[condicao],
			        fct_saldoEstoque[serializado],
			        fct_saldoEstoque[tem_caracter_incorreto]
			    ),
			        CALCULATE(
			            [saldoEF_disponivel],
			            KEEPFILTERS(fct_saldoEstoque),
			            fct_saldoEstoque[data_saldo] = MAX(fct_saldoEstoque[data_saldo])
			        )
			)
		formatString: #,0
		displayFolder: EstoqueFisico
		lineageTag: e11f6a80-0eba-40cd-bf8b-d77f4b6e225b

		annotation PBI_FormatHint = {"isDecimal":true}

