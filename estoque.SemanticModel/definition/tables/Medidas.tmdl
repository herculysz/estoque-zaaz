	measure qtd_aplic = CALCULATE(SUM(fct_MateriaisAplicados[quantidade]))+0
		displayFolder: Aplicados
		lineageTag: 0dbd3a91-96f6-41bd-a01e-93b6365c505c

		formatStringDefinition = "#,0"

	measure qtd_Aplic_Mes_Anterior = ```
			
			VAR MesAnterior = CALCULATE(
			    [qtd_aplic], 
			    DATEADD('dim_Calendario'[data_formatada], -1, MONTH)
			)
			RETURN
			MesAnterior
			```
		displayFolder: Aplicados
		lineageTag: 5c298372-3549-4eac-9790-d6e766b3184d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '% Diff_Aplic_mes_Anterior' =
			
			VAR MesAtual = [qtd_aplic]
			VAR MesAnterior = [qtd_Aplic_Mes_Anterior]
			VAR CalcDiffMes = DIVIDE( MesAtual - MesAnterior, MesAnterior, 0 )
			RETURN
			
			
			IF(CalcDiffMes >0, "+"&FORMAT(CalcDiffMes, "0.00%"), CalcDiffMes)
		formatString: 0.00%;-0.00%;0.00%
		displayFolder: Aplicados
		lineageTag: 7c5ced96-452a-4781-8f83-c9e1bc9693fb

	measure '% Aplic_mes' = ```
			
			
			VAR totalmes = 
			CALCULATE(
			    [qtd_aplic],
			    KEEPFILTERS('dim_calendario'),
			    ALLSELECTED(fct_materiaisAplicados[categoria_tecnologia])
			)
			RETURN
			
			" | " &
			FORMAT(
			    DIVIDE([qtd_aplic], totalmes, 0),
			    "0.00%"
			)
			```
		displayFolder: Aplicados
		lineageTag: 7e0b1a3d-de33-49d7-bb3c-8e1ec1ee7df0

	measure AplicMediaMes = ```
			
			    VAR TabelaFiltrada = 
			        CALCULATETABLE(
			            DISTINCT(
			                SELECTCOLUMNS(
			                    'fct_materiaisAplicados',
			                    "MesRef", DATE(YEAR(fct_materiaisAplicados[baixa_protocolo_data]), 
			                                   MONTH(fct_materiaisAplicados[baixa_protocolo_data]), 1)
			                )
			            )
			        )  
			    VAR _MesesFiltrados = COUNTROWS(TabelaFiltrada)
			    --VAR qtdAplic = SUM(f_MateriaisAplicados[Qtde. Aplic.])
			
			    RETURN
			    IF(
			        _MesesFiltrados = 0,
			        BLANK(),
			        DIVIDE([qtd_aplic], _MesesFiltrados, 0)
			    )
			```
		displayFolder: Aplicados
		lineageTag: ba2dcf8f-f7b5-4bf5-9ac0-5343a151f105

