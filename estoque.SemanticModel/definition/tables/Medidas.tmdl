	measure @corEvoluçãoReq =
			
			
			VAR variavelCor = [% Diff_Req_mes_Anterior]
			RETURN
			
			SWITCH(
			    TRUE(),
			    variavelCor = 0, BLANK(),
			    variavelCor < 0, "#A50B00",
			    variavelCor > 0 || CONTAINSSTRING("+", variavelCor), "#00A023",
			    BLANK()
			)
		displayFolder: Requisicao
		lineageTag: 988112b0-88b9-40c0-8de9-5957ade84a0a

