annotation PBI_QueryOrder = ["db","hostname","fct_saldoEstoque","fct_saldoVolante","fct_materiaisAplicados","fct_materiaisRetirados","fct_conversaoMateriais","fct_updated","dim_calendario","fct_requisicaoMaterial","fct_devolucaoMaterial","fct_historico_equipamento"]

annotation PBI_ProTooling = ["TMDLView_Desktop","DevMode","MCP-PBIModeling"]

annotation __TEdtr = 1

