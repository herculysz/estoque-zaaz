		column tem_caracter_incorreto = ```
				
				
				VAR ignorarCategorias = NOT(fct_requisicaoMaterial[categoria_tecnologia] IN {"SEM INFORMACAO", "MISCELANEA", "INSUMO"})
				VAR ignorarNaoSerializados = fct_requisicaoMaterial[numero_serie] <> "-"
				VAR ignorarSeriaisVazios = fct_requisicaoMaterial[numero_serie] <> "" && NOT ISBLANK(fct_requisicaoMaterial[numero_serie])
				VAR ignorarSemInformacao = fct_requisicaoMaterial[numero_serie] <> "SEM INFORMACAO"
				
				VAR serialAtual = fct_requisicaoMaterial[numero_serie]
				VAR tamanhoSerial = LEN(serialAtual)
				
				
				VAR sequenciaZeros = REPT("0", tamanhoSerial)
				VAR sequenciaUns = REPT("1", tamanhoSerial)
				
				VAR ehRepeticaoInvalida = 
				    tamanhoSerial >= 1 && 
				    tamanhoSerial <= 7 && 
				    (serialAtual = sequenciaZeros || serialAtual = sequenciaUns)
				
				RETURN
				IF(
				    (CONTAINSSTRING(serialAtual, " ") && ignorarSemInformacao)||
				    CONTAINSSTRING(serialAtual, "/") ||
				    CONTAINSSTRING(serialAtual, "\") ||
				    CONTAINSSTRING(serialAtual, ".") ||
				    CONTAINSSTRING(serialAtual, ",") ||
				    CONTAINSSTRING(serialAtual, "+") ||
				    CONTAINSSTRING(serialAtual, ":") ||
				    CONTAINSSTRING(serialAtual, ";") ||
				    CONTAINSSTRING(serialAtual, "!") ||
				    CONTAINSSTRING(serialAtual, "(") ||
				    CONTAINSSTRING(serialAtual, ")") ||
				    CONTAINSSTRING(serialAtual, "&") ||
				    CONTAINSSTRING(serialAtual, "$") ||
				    CONTAINSSTRING(serialAtual, "@") ||
				    CONTAINSSTRING(serialAtual, "~*") ||
				    CONTAINSSTRING(serialAtual, "~?") ||
				    CONTAINSSTRING(serialAtual, "~~") || 
				    CONTAINSSTRING(serialAtual, "^") ||
				    CONTAINSSTRING(serialAtual, "<") ||
				    CONTAINSSTRING(serialAtual, ">") ||
				    CONTAINSSTRING(serialAtual, "´") ||
				    CONTAINSSTRING(serialAtual, "`") ||
				    CONTAINSSTRING(serialAtual, "'") ||
				    CONTAINSSTRING(serialAtual, "%") ||
				    CONTAINSSTRING(serialAtual, "[") ||
				    CONTAINSSTRING(serialAtual, "]") ||
				    CONTAINSSTRING(serialAtual, "{") ||
				    CONTAINSSTRING(serialAtual, "}") ||
				    ehRepeticaoInvalida ||
				    (serialAtual = "SN" && ignorarCategorias) ||
				    (tamanhoSerial < 8 && ignorarNaoSerializados && ignorarCategorias && ignorarSeriaisVazios) ||
				    (ignorarNaoSerializados && CONTAINSSTRING(serialAtual, "-") && ignorarCategorias), 
				    "SIM", 
				    "NÃO"
				)
				```
			lineageTag: a80f7249-ee60-4a5a-ace8-0e25a2136049
			summarizeBy: none

			annotation SummarizationSetBy = Automatic

		partition fct_requisicaoMaterial = m
			mode: import
			source = ```
					let
					    Fonte = Value.NativeQuery(PostgreSQL.Database(hostname, db), 
					    "
					    SELECT DISTINCT
					        dim_movimento_rmdm.sk_movimento_rmdm,
					        --dim_movimento_rmdm.numero_documento,
					        dim_movimento_rmdm.base,
					        dim_movimento_rmdm.contrato,
					        dim_movimento_rmdm.projeto,
					        dim_movimento_rmdm.data_movimentacao_rmdm,
					        dim_material.categoria_tecnologia,
					        dim_movimento_rmdm.condicao,
					        dim_material.bk_material,
					        dim_material.descricao_material,
					        dim_material.unidade_medida,
					        dim_serial_equipamento.numero_serie, --COALESCE(dim_serial_equipamento.numero_serie, dim_movimento_rmdm.numero_serie) as numero_serie
					        dim_movimento_rmdm.serializado,
					        fct_movimento_requisicao.quantidade_solicitada,
					        fct_movimento_requisicao.quantidade_executada,
					        dim_colaborador.nome,
					        dim_colaborador.descricao_funcao,
					        dim_movimento_rmdm.status_baixada,
					        dim_movimento_rmdm.status_cancelado 
					    FROM gold.dim_movimento_rmdm AS dim_movimento_rmdm
					    inner join gold.fct_movimento_requisicao as fct_movimento_requisicao on (fct_movimento_requisicao.sk_movimento_rmdm = dim_movimento_rmdm.sk_movimento_rmdm)
					    left join gold.dim_material as dim_material on (dim_material.sk_material = fct_movimento_requisicao.sk_material)
					    left join gold.dim_colaborador as dim_colaborador on (dim_colaborador.sk_colaborador = fct_movimento_requisicao.sk_colaborador_requisitante)
					    left join gold.dim_serial_equipamento as dim_serial_equipamento on (dim_serial_equipamento.sk_numero_serie = fct_movimento_requisicao.sk_numero_serie)
						
						", null, [EnableFolding=true]),
					    #"Dividir Coluna por Delimitador" = Table.SplitColumn(Table.TransformColumnTypes(Fonte, {{"data_movimentacao_rmdm", type text}}, "pt-BR"), "data_movimentacao_rmdm", Splitter.SplitTextByEachDelimiter({" "}, QuoteStyle.Csv, false), {"data_movimentacao_rmdm.1", "data_movimentacao_rmdm.2"}),
					    #"Tipo Alterado" = Table.TransformColumnTypes(#"Dividir Coluna por Delimitador",{{"data_movimentacao_rmdm.1", type date}, {"data_movimentacao_rmdm.2", type time}, {"sk_movimento_rmdm", type text}}),
					    #"Colunas Renomeadas" = Table.RenameColumns(#"Tipo Alterado",{{"data_movimentacao_rmdm.1", "data_movimentacao_rmdm"}, {"data_movimentacao_rmdm.2", "hora_movimentacao_rmdm"}})
					in
					    #"Colunas Renomeadas"
					```

		annotation PBI_NavigationStepName = Navegação

		annotation PBI_ResultType = Table

