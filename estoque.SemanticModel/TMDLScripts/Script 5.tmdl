		column serializado
			dataType: string
			lineageTag: 0623d621-c3bd-485a-a1d2-f44e4147188b
			summarizeBy: none
			sourceColumn: serializado

			annotation SummarizationSetBy = Automatic

		column tem_caracter_incorreto = ```
				
				--IF(CONTAINSSTRING(fct_saldoEstoque[numero_serie], " "), "SIM", "NÃO")
				
				VAR ignorarCategorias = NOT(fct_saldoEstoque[categoria_tecnologia] IN {"SEM INFORMACAO", "MISCELANEA", "INSUMO", ""})
				VAR ignorarNaoSerializados = fct_saldoEstoque[numero_serie] <> "-"
				
				VAR serialAtual = fct_saldoEstoque[numero_serie]
				VAR tamanhoSerial = LEN(serialAtual)
				
				
				VAR sequenciaZeros = REPT("0", tamanhoSerial)
				VAR sequenciaUns = REPT("1", tamanhoSerial)
				
				VAR ehRepeticaoInvalida = 
				    tamanhoSerial >= 1 && 
				    tamanhoSerial <= 7 && 
				    (serialAtual = sequenciaZeros || serialAtual = sequenciaUns)
				
				RETURN
				IF(
				    CONTAINSSTRING(serialAtual, " ") ||
				    CONTAINSSTRING(serialAtual, "/") ||
				    CONTAINSSTRING(serialAtual, "\") ||
				    CONTAINSSTRING(serialAtual, ".") ||
				    CONTAINSSTRING(serialAtual, ",") ||
				    CONTAINSSTRING(serialAtual, "+") ||
				    CONTAINSSTRING(serialAtual, ":") ||
				    CONTAINSSTRING(serialAtual, ";") ||
				    CONTAINSSTRING(serialAtual, "!") ||
				    CONTAINSSTRING(serialAtual, "(") ||
				    CONTAINSSTRING(serialAtual, ")") ||
				    CONTAINSSTRING(serialAtual, "&") ||
				    CONTAINSSTRING(serialAtual, "$") ||
				    CONTAINSSTRING(serialAtual, "@") ||
				    CONTAINSSTRING(serialAtual, "~*") ||
				    CONTAINSSTRING(serialAtual, "~?") ||
				    CONTAINSSTRING(serialAtual, "~~") || 
				    CONTAINSSTRING(serialAtual, "^") ||
				    CONTAINSSTRING(serialAtual, "<") ||
				    CONTAINSSTRING(serialAtual, ">") ||
				    CONTAINSSTRING(serialAtual, "´") ||
				    CONTAINSSTRING(serialAtual, "`") ||
				    CONTAINSSTRING(serialAtual, "'") ||
				    CONTAINSSTRING(serialAtual, "%") ||
				    CONTAINSSTRING(serialAtual, "[") ||
				    CONTAINSSTRING(serialAtual, "]") ||
				    CONTAINSSTRING(serialAtual, "{") ||
				    CONTAINSSTRING(serialAtual, "}") ||
				    ehRepeticaoInvalida ||
				    (serialAtual = "SN" && ignorarCategorias) ||
				    (ignorarNaoSerializados && [saldoEF_disponivel] > 1) ||
				    (tamanhoSerial < 8 && ignorarNaoSerializados && ignorarCategorias) ||
				    (ignorarNaoSerializados && CONTAINSSTRING(serialAtual, "-") && ignorarCategorias), 
				    "SIM", 
				    "NÃO"
				)
				```
			lineageTag: f667dd09-8dae-41f6-9f67-7725587cc9f5
			summarizeBy: none

			annotation SummarizationSetBy = Automatic

		column base
			dataType: string
			lineageTag: ce149e03-1244-4da8-91dc-844a661032d1
			summarizeBy: none
			sourceColumn: base

			annotation SummarizationSetBy = Automatic

		partition fct_saldoEstoque = m
			mode: import
			source = ```
					let
					    Fonte = Value.NativeQuery(PostgreSQL.Database(hostname, db), "
						with max_data_saldo as (
							select distinct
								dim_saldo_tecnico_estoque.base as base,
								max(dim_saldo_tecnico_estoque.data_saldo) as data_saldo
							from gold.dim_saldo_tecnico_estoque as dim_saldo_tecnico_estoque
							group by dim_saldo_tecnico_estoque.base
						)
						select distinct
							dim_saldo_tecnico_estoque.sk_saldo,
							dim_saldo_tecnico_estoque.data_saldo,
							dim_saldo_tecnico_estoque.base,
							dim_saldo_tecnico_estoque.contrato,
							dim_saldo_tecnico_estoque.projeto,
							dim_serial_equipamento.numero_serie,
							dim_material.bk_material,
							dim_material.descricao_material,
							dim_material.unidade_medida,
							fct_saldo_estoque.saldo_estoque,
							fct_saldo_estoque.programado_rm,
							fct_saldo_estoque.programado_tm,
							fct_saldo_estoque.saldo_disponivel,
							dim_material.categoria_tecnologia,
							dim_saldo_tecnico_estoque.condicao,
							dim_saldo_tecnico_estoque.serializado
						from max_data_saldo
						left join gold.dim_saldo_tecnico_estoque as dim_saldo_tecnico_estoque on (dim_saldo_tecnico_estoque.base = max_data_saldo.base  
																									and dim_saldo_tecnico_estoque.data_saldo = max_data_saldo.data_saldo)
						inner join gold.fct_saldo_estoque as fct_saldo_estoque on (fct_saldo_estoque.sk_saldo = dim_saldo_tecnico_estoque.sk_saldo)
						left join gold.dim_material as dim_material on (dim_material.sk_material = fct_saldo_estoque.sk_material)
						left join gold.dim_serial_equipamento as dim_serial_equipamento on (dim_serial_equipamento.sk_numero_serie = fct_saldo_estoque.sk_numero_serie)
						
						", null, [EnableFolding=true]),
					    #"Tipo Alterado" = Table.TransformColumnTypes(Fonte,{{"data_saldo", type date}})
					in
					    #"Tipo Alterado"
					```

		annotation PBI_NavigationStepName = Navegação

		annotation PBI_ResultType = Table

