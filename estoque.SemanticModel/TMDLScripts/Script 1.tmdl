		partition fct_conversaoMateriais = m
			mode: import
			source = ```
					let
					    Fonte = Value.NativeQuery(PostgreSQL.Database(hostname, db), "
					    
					    /* CONVERSAO MATERIAL */
					    SELECT
					        dim_conversao_equipamento.sk_conversao_equipamento,
					        dim_conversao_equipamento.contrato,
					        dim_conversao_equipamento.projeto,
					        dim_conversao_equipamento.data_conversao::date as data_conversao,
					        dim_conversao_equipamento.condicao_original,
					        dim_conversao_equipamento.condicao_convertida,
					        dim_conversao_equipamento.conversao_automatica,
					        dim_conversao_equipamento.status_baixa,
					        fct_conversao_equipamento.quantidade_convertido,
					        dim_serial_equipamento_original.numero_serie as numero_serie_original,
					        dim_serial_equipamento_convertido.numero_serie as numero_serie_convertido,
					        dim_material_original.bk_material as bk_material_original,
					        dim_material_original.descricao_material as descricao_material_original,
					        dim_material_original.unidade_medida as unidade_medida_original,
					        dim_material_convertido.bk_material as bk_material_convertido,
					        dim_material_convertido.descricao_material as descricao_material_convertido,
					        dim_material_convertido.unidade_medida as unidade_medida_convertido,
					        dim_colaborador.cpf_colaborador,
					        dim_colaborador.nome,
					        dim_colaborador.descricao_funcao
					    FROM gold.dim_conversao_equipamento as dim_conversao_equipamento
					    inner join gold.fct_conversao_equipamento as fct_conversao_equipamento on (fct_conversao_equipamento.sk_conversao_equipamento = dim_conversao_equipamento.sk_conversao_equipamento)
					    left join gold.dim_serial_equipamento as dim_serial_equipamento_original on (dim_serial_equipamento_original.sk_numero_serie = fct_conversao_equipamento.sk_numero_serie)
					    left join gold.dim_serial_equipamento as dim_serial_equipamento_convertido on (dim_serial_equipamento_convertido.sk_numero_serie = fct_conversao_equipamento.sk_numero_serie_convertido)
					    left join gold.dim_material as dim_material_original on (dim_material_original.sk_material = fct_conversao_equipamento.sk_material)
					    left join gold.dim_material as dim_material_convertido on (dim_material_convertido.sk_material = fct_conversao_equipamento.sk_material_convertido)
					    left join gold.dim_colaborador as dim_colaborador on (dim_colaborador.sk_colaborador = fct_conversao_equipamento.sk_colaborador)
					    
					    ", null, [EnableFolding=true])
					in
					    Fonte
					```

		annotation PBI_NavigationStepName = Navegação

		annotation PBI_ResultType = Exception

