		partition fct_requisicaoMaterial = m
			mode: import
			source = ```
					let
					    Fonte = Value.NativeQuery(PostgreSQL.Database(hostname, db), 
					    "
					    SELECT DISTINCT
					        dim_movimento_rmdm.sk_movimento_rmdm,
					        --dim_movimento_rmdm.numero_documento,
					        dim_movimento_rmdm.base,
					        dim_movimento_rmdm.contrato,
					        dim_movimento_rmdm.projeto,
					        dim_movimento_rmdm.data_movimentacao_rmdm,
					        dim_material.categoria_tecnologia,
					        dim_movimento_rmdm.condicao,
					        dim_material.bk_material,
					        dim_material.descricao_material,
					        dim_material.unidade_medida,
					        dim_serial_equipamento.numero_serie, --COALESCE(dim_serial_equipamento.numero_serie, dim_movimento_rmdm.numero_serie) as numero_serie
					        dim_movimento_rmdm.serializado,
					        fct_movimento_requisicao.quantidade_solicitada,
					        fct_movimento_requisicao.quantidade_executada,
					        dim_colaborador.nome,
					        dim_colaborador.descricao_funcao,
					        dim_movimento_rmdm.status_baixada,
					        dim_movimento_rmdm.status_cancelado 
					    FROM gold.dim_movimento_rmdm AS dim_movimento_rmdm
					    inner join gold.fct_movimento_requisicao as fct_movimento_requisicao on (fct_movimento_requisicao.sk_movimento_rmdm = dim_movimento_rmdm.sk_movimento_rmdm)
					    left join gold.dim_material as dim_material on (dim_material.sk_material = fct_movimento_requisicao.sk_material)
					    left join gold.dim_colaborador as dim_colaborador on (dim_colaborador.sk_colaborador = fct_movimento_requisicao.sk_colaborador_requisitante)
					    left join gold.dim_serial_equipamento as dim_serial_equipamento on (dim_serial_equipamento.sk_numero_serie = fct_movimento_requisicao.sk_numero_serie)
						
						", null, [EnableFolding=true])
					in
					    Fonte
					```

		annotation PBI_NavigationStepName = Navegação

		annotation PBI_ResultType = Exception

